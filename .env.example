# Server Network Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:password@ep-sparkling-band-b4621xgb-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Security & Authentication (Change in production)
